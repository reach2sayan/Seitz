# Build trees, fetched dependencies, caches
/build/
/cmake-build-*/
/.cache/
/.deps/
/_skbuild/
/dist/
*.egg-info/
CMakeUserPresets.json
compile_commands.json
*.ddi

# IDE and editor state
/.idea/
/.vs/
/.vscode/
*.user
*.swp
*~

# Python
/.venv/
__pycache__/
*.py[cod]
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# Transcribed tables: CMake generates them into the build tree from spglib's
# sources and the CSVs under tools/ (tools/transcribe_*.py). Never tracked;
# these paths only catch leftovers of checkouts that predate that.
/include/seitz/data/*_tables.hpp
/include/seitz/data/subgroup_relations.hpp
/src/data/*_tables.hpp
/src/data/hall_generators.hpp

# Working notes, kept on disk only
/docs/*.md

# Tracked on purpose: uv.lock, .python-version, python/seitz/py.typed, and the
# stubs python/seitz/_core/*.pyi (CI regenerates them with
# tools/fix_core_stubs.py and fails on a diff).
