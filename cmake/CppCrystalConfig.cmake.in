@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3)
# Which Boost components a consumer needs depends on how the library was built.
# Eigen and Boost.Container appear in the installed headers and Boost.LEAF in
# the Result<T> return type, so those are always required. The PRIVATE links
# (Boost::flyweight, Boost::geometry) are only required where the library is a
# static archive: a shared object has already resolved them and keeps them out
# of its exported interface, while a static one records them as
# $<LINK_ONLY:...> in INTERFACE_LINK_LIBRARIES and the consumer's link line
# does need the targets to exist.
if ("@CPPCRYSTAL_LIBRARY_TYPE@" STREQUAL "SHARED")
    find_dependency(Boost COMPONENTS container leaf)
else ()
    find_dependency(Boost COMPONENTS container leaf flyweight geometry)
endif ()
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/CppCrystalTargets.cmake")
check_required_components(CppCrystal)
