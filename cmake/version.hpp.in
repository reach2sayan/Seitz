#pragma once

#pragma GCC visibility push(default)

namespace seitz {

struct Version {
  int major;
  int minor;
  int patch;
};

// This port's version, configured from `project(Seitz VERSION ...)` in
// CMakeLists.txt -- the only place the number is written. The wheel metadata
// reads that same line (scikit-build-core's regex provider) and the release
// tag is checked against it.
inline constexpr Version kVersion{@PROJECT_VERSION_MAJOR@,
                                  @PROJECT_VERSION_MINOR@,
                                  @PROJECT_VERSION_PATCH@};

// The reference spglib release whose behaviour this port targets and validates
// against (see the oracle test setup).
inline constexpr Version kReferenceSpglibVersion{2, 7, 0};

// The same number as a C string. Configured here beside kVersion rather than
// defined on version.cpp's command line: one quoting scheme across GCC, Clang
// and MSVC, and no rebuild this header does not already force.
#define SEITZ_VERSION_STRING "@PROJECT_VERSION@"

// "major.minor.patch" of this port.
[[nodiscard]] char const *version_string() noexcept;

} // namespace seitz

#pragma GCC visibility pop
