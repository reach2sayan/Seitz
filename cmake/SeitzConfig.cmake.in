@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Version floors, interpolated from cmake/Dependencies.cmake so they cannot drift
# from what the library was built against. Without them a consumer with, say,
# Eigen 3.4 or Boost 1.83 installed configures cleanly and then fails deep inside
# a header -- relocating downstream exactly the breakage the compiler-version
# gate in CMakeLists.txt exists to catch early.
find_dependency(Eigen3 @SEITZ_EIGEN_MIN@)
# Which Boost components a consumer needs depends on how the library was built.
# Eigen and Boost.Container appear in the installed headers, Boost.Graph in the
# subgroup-graph interface and Boost.LEAF in the Result<T> return type; all
# three are linked PUBLIC, so the exported target names them whatever the
# library type is. The PRIVATE links (Boost::flyweight, Boost::parser, ...) are
# only required where the library is a static archive: a shared object has
# already resolved them and keeps them out of its exported interface, while a
# static one records them as $<LINK_ONLY:...> in INTERFACE_LINK_LIBRARIES and
# the consumer's link line does need the targets to exist. Boost::algorithm
# and ::range are there too: no installed header names them.
if ("@SEITZ_LIBRARY_TYPE@" STREQUAL "SHARED")
    find_dependency(Boost @SEITZ_BOOST_MIN@ COMPONENTS container graph leaf)
else ()
    find_dependency(Boost @SEITZ_BOOST_MIN@ COMPONENTS container graph leaf
            flyweight parser algorithm range)
endif ()
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/SeitzTargets.cmake")
check_required_components(Seitz)
