{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPGLIB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPGLIB_BUILD_TESTS": "ON",
        "SPGLIB_BUILD_ORACLE_TESTS": "ON"
      }
    },
    {
      "name": "mkl",
      "displayName": "Release + MKL",
      "inherits": "release",
      "cacheVariables": {
        "SPGLIB_USE_MKL": "ON"
      }
    },
    {
      "name": "oracle",
      "displayName": "Debug + reference-spglib oracle",
      "inherits": "default",
      "cacheVariables": {
        "SPGLIB_BUILD_ORACLE_TESTS": "ON"
      }
    },
    {
      "name": "oracle-asan",
      "displayName": "Debug + oracle + Address/UB sanitizers",
      "inherits": "oracle",
      "cacheVariables": {
        "SPGLIB_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "mkl",
      "configurePreset": "mkl"
    },
    {
      "name": "oracle",
      "configurePreset": "oracle"
    },
    {
      "name": "oracle-asan",
      "configurePreset": "oracle-asan"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oracle",
      "configurePreset": "oracle",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oracle-asan",
      "configurePreset": "oracle-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
