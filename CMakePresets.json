{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-15",
        "CMAKE_CXX_COMPILER": "g++-15",
        "CPPCRYSTAL_BUILD_TESTS": "ON",
        "CPPCRYSTAL_BUILD_ORACLE_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug + reference-spglib oracle",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release + reference-spglib oracle",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + oracle + Address/UB sanitizers",
      "inherits": "debug",
      "cacheVariables": {
        "CPPCRYSTAL_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "python",
      "displayName": "Release + Python bindings",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPPCRYSTAL_BUILD_PYTHON": "ON",
        "CPPCRYSTAL_BUILD_TESTS": "OFF",
        "CPPCRYSTAL_BUILD_DEMO": "OFF",
        "CPPCRYSTAL_BUILD_ORACLE_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "python",
      "configurePreset": "python"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "python",
      "configurePreset": "python",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
