# compile_commands.json is generated by the GCC build (the presets default to
# gcc-15), so it carries GCC spellings that clang's driver rejects outright.
# clangd then falls back to a flagless command and reports diagnostics the real
# build never sees -- most visibly the consteval tables in
# include/seitz/data/spacegroup_symbols.hpp and the subgroup graph, which blow
# clang's default 1048576-step budget and come back as "not a constant
# expression".
CompileFlags:
  Remove:
    - -fconstexpr-ops-limit=*
  Add:
    - -fconstexpr-steps=100000000
